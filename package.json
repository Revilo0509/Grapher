{
	"name": "grapher",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev:rust": "cd rust && wasm-pack build --target web --out-dir pkg",
		"dev:rust:watch": "cd rust && cargo watch -w src -s 'wasm-pack build --target web --out-dir pkg'",
		"dev:frontend": "vite dev",
		"dev": "concurrently -k \"pnpm dev:rust:watch\" \"pnpm dev:frontend\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/adapter-auto": "latest",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "^7.1.1",
		"@tailwindcss/vite": "^4.2.4",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"esbuild": "^0.28.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rollup": "^4.60.3",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1",
		"mode-watcher": "^1.1.0",
		"rust": "link:rust/pkg"
	}
}
